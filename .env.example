PORT=3000

NODE_ENV=development
SERVICE_NAME=central-promos-enginee

MONGO_URL=mongodb://localhost:27017/central-promos-enginee

MERCADOLIBRE_API_BASE_URL=https://api.meli.loquieroaca.com
MERCADOLIBRE_API_TIMEOUT=10000
MERCADOLIBRE_API_TOKEN=
MERCADOLIBRE_APP_KEY=promotions-engine-api

PRICE_API_BASE_URL=https://api.price.loquieroaca.com
PRICE_API_TIMEOUT=10000
PRICE_API_TOKEN=

# Catalog-Meli analytics API. Primary source for item detail (sku/category/listingType/price)
# during sync and deactivate-failed; on failure the process falls back to the Mercado Libre API.
CATALOG_MELI_API_BASE_URL=https://catalog-meli.loquieroaca.com
CATALOG_MELI_API_TIMEOUT=10000
CATALOG_MELI_API_TOKEN=
# Set to false to bypass Catalog-Meli entirely and read item detail straight from Mercado Libre.
CATALOG_MELI_API_ENABLED=true

CAMPAIGN_MLA_API_BASE_URL=https://api.madre.loquieroaca.com
CAMPAIGN_MLA_API_TIMEOUT=10000
CAMPAIGN_MLA_API_TOKEN=

AUTOMELI_API_BASE_URL=
AUTOMELI_API_TIMEOUT=10000
AUTOMELI_API_TOKEN=
AUTOMELI_SELLER_ID=

DEAL_PRICE_CONTROL_ENABLED=false
DEAL_PRICE_CONTROL_MAX_BASE_INCREASE_PERCENTAGE=0.3

SYNC_PROMOTION_TYPES=PRE_NEGOTIATED,DEAL,SMART

# Max number of different promotions synced concurrently. Pagination within a single
# promotion always stays sequential (searchAfter); this only bounds how many promotions
# run in parallel, to avoid saturating Mercado Libre.
SYNC_PROMOTION_CONCURRENCY=3

SYNC_PROMOTIONS_CRON=0 */30 * * * *
ACTIVATE_PROMOTIONS_CRON=0 */15 * * * *
DEACTIVATE_PROMOTIONS_CRON=0 */20 * * * *

# Comma-separated subset of: sync,activate,deactivate. Controls which cron jobs run on this instance. Empty (or unset) means all three are active.
ENABLED_CRON_PROCESSES=

DEFAULT_MIN_PROFITABILITY=12
DEFAULT_MIN_PROFIT=0

METRICS_LOGGING_ENABLED=false
